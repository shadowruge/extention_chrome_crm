{
  "manifest_version": 3,
  "name": "WhatsApp CRM Extension",
  "description": "Extensão independente para organizar atendimentos no WhatsApp Web",
  "version": "1.0.1",
  "permissions": [
    "storage"
  ],
  "commands": {
    "open_side_panel": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Abrir painel lateral do WhatsApp CRM"
    }
  },
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["src/scripts/content.js"],
      "css": ["src/components/content.css"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*"
  ],
  "background": {
    "scripts": [
      "src/scripts/panel.js",
      "src/scripts/calendar.js",
      "src/scripts/background.js"
    ]
  },
  "sidebar_action": {
    "default_title": "WhatsApp CRM",
    "default_panel": "src/pages/sidepanel.html",
    "default_icon": "assets/icon48.png"
  },
  "action": {
    "default_popup": "src/pages/popup.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "whatsapp-crm@infodevbrasil.com",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
