{
  "manifest_version": 3,
  "name": "WhatsApp CRM Extension",
  "description": "Extensão para Google Chrome integrada ao WhatsApp Web com recursos de CRM e produtividade",
  "version": "1.0.0",
  "permissions": [
    "storage",
    "sidePanel"
  ],
  "commands": {
    "open_side_panel": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Abrir painel lateral do WhatsApp CRM"
    }
  },
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["src/scripts/content.js"],
      "css": ["src/components/content.css"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*"
  ],
  "background": {
    "service_worker": "src/scripts/background.js"
  },
  "side_panel": {
    "default_path": "src/pages/sidepanel.html",
    "openPanelOnActionClick": true
  },
  "action": {
    "default_popup": "src/pages/popup.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  }
}